@model HealthTracker.Models.WellnessEntry

@{
    var hour = DateTime.Now.Hour;
    var greeting = hour < 12
        ? "Good morning"
        : hour < 18
            ? "Good afternoon"
            : "Good evening";

    var name = ViewBag.FirstName;

    ViewData["Title"] = "Home";
}
<!-- HERO SECTION -->
<div class="hero-section text-white d-flex align-items-center justify-content-center mb-4">

    <div class="hero-overlay"></div>

    <div class="hero-content text-center">

        <h1 class="display-3 fw-bold text-white">HealthyMe</h1>

        <p class="lead mt-3 text-white">
            Track your sleep, hydration, mood, and activity
            to build healthier daily habits.
        </p>

        <a asp-controller="Wellness" asp-action="Create"
           class="btn btn-light btn-lg mt-3 me-2 hero-btn">
            Add Today's Entry
        </a>

        <a asp-controller="Wellness" asp-action="Dashboard"
           class="btn btn-outline-light btn-lg mt-3 hero-btn">
            View Dashboard
        </a>

    </div>

</div>

<!-- FEATURES SECTION -->
<div class="container mt-5">

    <h2 class="text-center mb-5 fw-bold">
        Your Wellness at a Glance
    </h2>

    <div class="row text-center">

        <div class="col-md-3 mb-4">
            <div class="feature-card p-4 h-100">

                <div class="feature-icon">💧</div>

                <h5 class="mt-3">Hydration</h5>

                <p class="text-muted">
                    Track your daily water intake and stay properly hydrated.
                </p>

            </div>
        </div>


        <div class="col-md-3 mb-4">
            <div class="feature-card p-4 h-100">

                <div class="feature-icon">😴</div>

                <h5 class="mt-3">Sleep</h5>

                <p class="text-muted">
                    Monitor how many hours you sleep and improve recovery.
                </p>

            </div>
        </div>


        <div class="col-md-3 mb-4">
            <div class="feature-card p-4 h-100">

                <div class="feature-icon">🚶</div>

                <h5 class="mt-3">Activity</h5>

                <p class="text-muted">
                    Log your daily steps and stay active every day.
                </p>

            </div>
        </div>


        <div class="col-md-3 mb-4">
            <div class="feature-card p-4 h-100">

                <div class="feature-icon">📊</div>

                <h5 class="mt-3">Insights</h5>

                <p class="text-muted">
                    View trends and understand your wellness progress.
                </p>

            </div>
        </div>

    </div>

